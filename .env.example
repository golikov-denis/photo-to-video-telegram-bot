# Telegram (required)
TELEGRAM_BOT_TOKEN=1234567890:replace_with_BotFather_token
TELEGRAM_WEBHOOK_SECRET=replace_with_at_least_32_random_characters
TELEGRAM_ADMIN_IDS=123456789

# Video provider: runway or kling
VIDEO_PROVIDER=kling
# Required only for the selected provider when USE_MOCK_RUNWAY=false
RUNWAYML_API_SECRET=
KLING_API_KEY=

# PostgreSQL (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/photo_video_bot

# Vercel Blob (required in production and real provider mode)
BLOB_READ_WRITE_TOKEN=

# Internal endpoints (required)
CRON_SECRET=replace_with_another_32_random_characters
APP_BASE_URL=http://localhost:3000

# Limits and feature switches
DAILY_GENERATION_LIMIT=5
MAX_CONCURRENT_GENERATIONS=2
GENERATIONS_ENABLED=false
USE_MOCK_RUNWAY=true
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
MAX_IMAGE_BYTES=10485760
MAX_VIDEO_BYTES=51380224
SOURCE_TTL_HOURS=24
MAX_SUBMISSION_ATTEMPTS=3
SUBMISSION_STALE_MINUTES=15
POLL_BATCH_SIZE=20
